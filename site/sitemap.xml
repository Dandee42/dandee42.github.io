---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {% assign build_time = site.time | date: '%Y-%m-%dT%H:%M:%S%:z' %}

  {% for lang in site.languages %}
    <sitemap>
      <loc>{{ site.url }}{{ site.baseurl }}/sitemap_{{ lang }}.xml</loc>
      <lastmod>{{ build_time }}</lastmod>
    </sitemap>
  {% endfor %}

</sitemapindex>